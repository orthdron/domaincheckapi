# Enable or disable rate limiting
# Values: true, false
ENABLE_RATE_LIMITS=false

# Redis URL for rate limiting storage (recommended for production)
# Format: redis://[:password@]host[:port][/db-number]
# Leave empty to use in-memory storage (not recommended for production)
REDIS_URL=

# Cache configuration
# Values: simple, redis
CACHE_TYPE=simple

# Redis URL for cache storage (only used if CACHE_TYPE=redis)
# Format: redis://[:password@]host[:port][/db-number]
CACHE_REDIS_URL=

# Timeout in seconds for WHOIS queries
# Recommended range: 3-10 seconds
# Increase this if you're getting timeout errors
WHOIS_TIMEOUT=5

# Timeout in seconds for DNS queries
# Recommended range: 2-5 seconds
# Lower values for faster response, higher for reliability
DNS_TIMEOUT=3

# Port for the application to run on
# Common values: 3000, 8000, 8080
# Note: Some platforms (Railway, Heroku) will override this
PORT=3000

# Cache configuration
# Values in seconds (300 = 5 minutes)
# Increase for less frequent updates, decrease for more frequent
CACHE_TIMEOUT=300

# Rate limiting configuration (only used if ENABLE_RATE_LIMITS=true)
# Single domain checks per minute per client
RATE_LIMIT_SINGLE=10
# Bulk domain checks per minute per client
RATE_LIMIT_BULK=5
# Checks per day per client (single and bulk combined)
RATE_LIMIT_DAILY=100

# Number of reverse proxies in front of the app (Railway, Dokploy, nginx: 1)
# Needed for per-client rate limits. Keep 0 if the app is exposed directly.
TRUSTED_PROXY_COUNT=0

# Maximum domains in bulk request
# Range: 1-50 (default: 10)
# Higher values increase response time
MAX_BULK_DOMAINS=10

# Maximum concurrent WHOIS/DNS lookups per process
LOOKUP_WORKERS=32

# Gunicorn: worker processes and threads per worker
# Keep WEB_CONCURRENCY=1 unless CACHE_TYPE=redis and REDIS_URL are set,
# otherwise each worker has its own cache and rate-limit counters.
WEB_CONCURRENCY=1
GUNICORN_THREADS=16
