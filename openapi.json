{
  "info": {
    "description": "API for checking domain availability using WHOIS and DNS lookups",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "contact": {
      "name": "Deepak Kapoor",
      "url": "https://github.com/orthdron/domaincheckapi"
    },
    "title": "Domain Check API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://domains.fiodel.com",
      "description": "Production server"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Domain Check"
        ],
        "summary": "Check domain availability",
        "description": "Check availability of a single domain using WHOIS and DNS",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Domain name to check (without TLD)"
          },
          {
            "name": "tld",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "com"
            },
            "description": "Top-level domain (e.g., com, net, org)"
          }
        ],
        "responses": {
          "200": {
            "description": "Domain check successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DomainCheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (only when ENABLE_RATE_LIMITS=true)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health check",
        "description": "Check if the API is running",
        "responses": {
          "200": {
            "description": "API is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Get API metrics",
        "description": "Get current API metrics including uptime and cache stats",
        "responses": {
          "200": {
            "description": "Metrics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bulk": {
      "post": {
        "tags": [
          "Domain Check"
        ],
        "summary": "Bulk domain check",
        "description": "Check availability of multiple domains at once",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk check successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/DomainCheckResponse"
                          },
                          {
                            "$ref": "#/components/schemas/BulkErrorItem"
                          }
                        ]
                      }
                    },
                    "response_time": {
                      "type": "string",
                      "example": "1.20s"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Rate limit exceeded (only when ENABLE_RATE_LIMITS=true)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "openapi": "3.0.3",
  "components": {
    "schemas": {
      "WhoisResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "taken",
              "error",
              "timeout"
            ]
          },
          "expiration_date": {
            "type": "string",
            "example": "2028-09-14",
            "description": "Only for taken domains",
            "nullable": true
          },
          "registrar": {
            "type": "string",
            "example": "MarkMonitor, Inc.",
            "description": "Only for taken domains",
            "nullable": true
          },
          "error": {
            "type": "string",
            "description": "Only when status is error or timeout"
          }
        },
        "additionalProperties": false
      },
      "DnsResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "available",
              "taken",
              "error",
              "timeout"
            ]
          },
          "ip": {
            "type": "string",
            "example": "93.184.216.34",
            "description": "Only for taken domains"
          },
          "error": {
            "type": "string",
            "description": "Only when status is error or timeout"
          }
        },
        "additionalProperties": false
      },
      "DomainCheckResponse": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "example": "example.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "taken",
              "unknown"
            ],
            "description": "taken if WHOIS or DNS finds the domain; unknown if WHOIS failed and DNS found nothing (retry later); otherwise available"
          },
          "whois": {
            "$ref": "#/components/schemas/WhoisResult"
          },
          "dns": {
            "$ref": "#/components/schemas/DnsResult"
          },
          "tld": {
            "type": "string",
            "example": "com"
          },
          "response_time": {
            "type": "string",
            "example": "0.45s"
          },
          "cached": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Invalid request"
          },
          "message": {
            "type": "string",
            "example": "Invalid domain name format"
          }
        },
        "additionalProperties": false
      },
      "MetricsResponse": {
        "type": "object",
        "properties": {
          "uptime": {
            "type": "string",
            "example": "1d 2h 34m"
          },
          "uptime_seconds": {
            "type": "integer",
            "example": 95640
          },
          "cache_stats": {
            "type": "object",
            "example": {
              "cache_hits": 150,
              "cache_misses": 50
            },
            "additionalProperties": {
              "type": "integer"
            }
          },
          "rate_limits": {
            "type": "object",
            "example": {
              "enabled": true,
              "single": "10 per minute",
              "bulk": "5 per minute",
              "daily": "100 per day"
            },
            "additionalProperties": {}
          }
        },
        "additionalProperties": false
      },
      "BulkCheckRequest": {
        "type": "object",
        "properties": {
          "domains": {
            "type": "array",
            "description": "Domain names (without TLD), or objects of the form {\"domain\": \"example\", \"tld\": \"org\"}. Maximum 10 by default.",
            "example": [
              "example",
              {
                "domain": "example",
                "tld": "org"
              }
            ],
            "items": {}
          },
          "tld": {
            "type": "string",
            "default": "com",
            "example": "com",
            "description": "Default TLD for entries without one"
          }
        },
        "required": [
          "domains"
        ],
        "additionalProperties": false
      },
      "BulkErrorItem": {
        "type": "object",
        "properties": {
          "domain": {
            "type": "string",
            "example": "inv@lid.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "error": {
            "type": "string",
            "example": "Invalid domain name format"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
